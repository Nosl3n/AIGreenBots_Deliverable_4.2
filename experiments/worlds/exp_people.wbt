#VRML_SIM R2025a utf8
# Husky A300 APPLE ORCHARD: tilled ground with raised beds, two walking workers and 5 rows x 12 apple trees
# trained as tall spindles (protos/AppleTree.proto): 1.3-3.2 m tall, so the canopy rises above the GPS antenna.
# Trees: webots-agri/tools/gen_apple_rows.py webots-agri/worlds/husky_apple.wbt --z 0.14
# The robot starts in the SOUTH headland, on the corridor centre line x = 1.25, facing north (+Y).

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "../../webots-agri/protos/HuskyA300.proto"
EXTERNPROTO "../../webots-agri/protos/AppleTree.proto"
EXTERNPROTO "../../webots-agri/protos/FieldTerrain.proto"

WorldInfo {
  info [ "AiGB UEx - Husky A300 apple orchard (tall spindle, raised beds)" ]
  basicTimeStep 8
  # GPS: WGS84 so the "gps" device returns latitude / longitude / altitude.
  # Reference = world origin, near the UEx campus in Badajoz. With northDirection 0 1 0, world +Y is
  # geographic north, +X is east (ENU).
  gpsCoordinateSystem "WGS84"
  gpsReference 38.8794 -6.9707 186
  northDirection 0 1 0
  contactProperties [
    ContactProperties {
      # Skid-steer on firm soil. Isotropic grip: a skid-steer turns by dragging its wheels sideways,
      # so lateral slip is part of the model (and the source of the odometry rotation scrub the
      # wheels+IMU fusion must correct). softCFM: four coplanar contacts on a rigid body rock under a
      # hard solver; a little compliance shares the load smoothly.
      material1 "HuskyWheelMat"
      coulombFriction [ 0.9 ]
      bounce 0
      softCFM 0.0005
    }
  ]
}
Viewpoint {
  orientation -0.33 0.33 0.88 1.70
  position 1.2 -17 7
  follow "husky"
}
TexturedBackground {
  texture "noon_cloudy_countryside"
}
TexturedBackgroundLight {
  texture "noon_cloudy_countryside"
}
# Ground: beds under the tree rows (x = -5 ... 5, y -7.6 ... 7.6), corridors and headlands at z ~ 0.
FieldTerrain {
}
DEF husky HuskyA300 {
  translation 1.25 -10.5 0.05
}
# ---- HUMANS: farm workers (Webots Pedestrian walking a trajectory, looped). No bounding object: they are for
# perception (ZED -> retina pose -> human_concept), the robot does not physically collide with them. ----
# ---- E2 WORKERS (experiments/scripts/gen_worlds.py) ----
DEF PERSON_CROSS_A Pedestrian {
  translation -4.0 -8.4 1.27
  name "crossing a"
  controllerArgs [
    "--trajectory=-4 -8.4, 4 -8.4"
    "--speed=0.5"
  ]
  shirtColor 0.85 0.45 0.1
}
DEF PERSON_CROSS_B Pedestrian {
  translation 4.0 -7.9 1.27
  name "crossing b"
  controllerArgs [
    "--trajectory=4 -7.9, -4 -7.9"
    "--speed=0.45"
  ]
  shirtColor 0.1 0.6 0.3
}
DEF PERSON_VEG Pedestrian {
  translation 1.25 6.0 1.27
  name "behind vegetation"
  controllerArgs [
    "--trajectory=1.25 6, 1.25 -6"
    "--speed=0.45"
  ]
  shirtColor 0.2 0.35 0.75
}
DEF PERSON_BEHIND Pedestrian {
  translation -1.7 -9.0 1.27
  name "behind"
  controllerArgs [
    "--trajectory=-1.7 -9, -1.7 7"
    "--speed=0.35"
  ]
  shirtColor 0.7 0.1 0.1
}
